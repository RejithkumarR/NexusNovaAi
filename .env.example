# Local Ollama inference (preferred self-hosted runtime)
NOVA_OLLAMA_BASE_URL=http://127.0.0.1:11434
NOVA_OLLAMA_MODEL=nova
NOVA_OLLAMA_TIMEOUT_SECONDS=120

# Vector database adapter. The configured service must expose POST /search
# with {"query": "...", "limit": 5} and return {"results": [{"text": "...", "score": 0.9}]}.
NOVA_VECTOR_DB_URL=http://127.0.0.1:YOUR_VECTOR_DB_PORT
NOVA_VECTOR_DB_API_KEY=
NOVA_VECTOR_DB_TIMEOUT_SECONDS=10

# Self-hosted app login. Change these values before deployment.
NOVA_AUTH_USERNAME=admin
NOVA_AUTH_PASSWORD=change-me
NOVA_AUTH_SECRET=change-this-secret
NOVA_AUTH_TOKEN_TTL_MINUTES=720

# Training uses a local/Hugging Face-compatible base checkpoint, not an Ollama tag.
NOVA_TRAINING_MODEL_NAME=/models/base-model
NOVA_TRAINING_OUTPUT_DIR=artifacts/nova-adapter
NOVA_TRAINING_EPOCHS=1

# Dataset storage
NOVA_DATASETS_DIR=datasets/uploads

# Optional direct Transformers runtime fallback
NOVA_MODEL_PATH=/models/nova
NOVA_DEVICE=auto
NOVA_MAX_NEW_TOKENS=512
NOVA_TEMPERATURE=0.7

# Code sandbox limits
NOVA_CODE_TIMEOUT_SECONDS=10
NOVA_CODE_MEMORY_MB=256
NOVA_CODE_CPU_LIMIT=1.0
NOVA_CODE_SANDBOX_IMAGE=nova-code-sandbox:latest
