# Local NOVA model checkpoint. Required for real self-hosted inference.
NOVA_MODEL_PATH=/models/nova
NOVA_DEVICE=auto
NOVA_MAX_NEW_TOKENS=512
NOVA_TEMPERATURE=0.7

# Code sandbox limits
NOVA_CODE_TIMEOUT_SECONDS=10
NOVA_CODE_MEMORY_MB=256
NOVA_CODE_CPU_LIMIT=1.0
NOVA_CODE_SANDBOX_IMAGE=nova-code-sandbox:latest
